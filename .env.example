# OpenTW — переменные окружения. Скопируйте в .env и заполните.
# Секреты хранятся ТОЛЬКО здесь, не в config.yaml.

# Токен Telegram-бота от @BotFather.
BOT_TOKEN=

# Обычный пользовательский API-ключ Tonworld.
API_KEY=

# Базовый URL Tonworld API (OpenAI-compatible).
# Можно также задать в config.yaml ключом api_base_url; ENV имеет приоритет.
API_BASE_URL=https://kube943.prod.tonworld.ru
