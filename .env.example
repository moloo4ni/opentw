# OpenTW environment variables. Copy to .env and fill in.
# Secrets live ONLY here, never in config.yaml.

# Telegram bot token from @BotFather.
BOT_TOKEN=

# Regular user API key for the OpenAI-compatible provider.
API_KEY=

# API base URL (OpenAI-compatible). Can also be set in config.yaml as
# api_base_url; the env var takes precedence.
API_BASE_URL=https://kube943.prod.tonworld.ru
